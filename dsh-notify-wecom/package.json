{
  "name": "dsh-notify-wecom",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: push a WeCom (企业微信) markdown notification over the aibot WebSocket channel when a top-level session goes idle",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "^1.0.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-user-approval": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-session-title": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
