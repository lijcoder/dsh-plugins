{
  "name": "@lijcoder/dsh-im-wecom-profile",
  "version": "0.1.0",
  "description": "DeepSeek Harness profile 组合包：一次装齐「IM 接缝 + 企业微信通道 + 通知 + / 命令」",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@lijcoder/dsh-client-im-wecom-profile": "workspace:^",
    "@lijcoder/dsh-im": "workspace:^",
    "@lijcoder/dsh-im-commands": "workspace:^",
    "@lijcoder/dsh-im-wecom": "workspace:^",
    "@lijcoder/dsh-notify": "workspace:^"
  },
  "devDependencies": {
    "@lijcoder/dsh-plugin-testkit": "workspace:*",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
