{
  "name": "@lijcoder/dsh-notify-wecom",
  "version": "0.1.0",
  "description": "DeepSeek Harness 组合包：企业微信通道 + 任务完成/授权通知 + 企微内 / 命令",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
